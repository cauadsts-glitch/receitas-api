# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# NUNCA envie o arquivo .env (com credenciais reais) para o Git.

# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave secreta (secret / service_role) do Supabase. Use somente no back-end.
SUPABASE_SECRET_KEY=sua-chave-secreta-aqui

# Porta da API (opcional, padrão: 3000)
PORT=3000

# DICA: para os testes de integração, use um projeto Supabase SEPARADO do de
# desenvolvimento. Crie um arquivo ".env.test" com as mesmas variáveis acima
# apontando para o banco de testes (ele tem prioridade sobre o ".env" nos testes).
