{
  "name": "receitas-api",
  "version": "1.0.0",
  "description": "API REST de receitas culinárias - Avaliação Final da disciplina de Desenvolvimento Back-end do curso de Engenharia de Software - 4P",
  "keywords": ["back-end", "ts", "api", "receitas", "recipes"],
  "homepage": "https://github.com/cauadsts-glitch/receitas-api#readme",
  "bugs": { "url": "https://github.com/cauadsts-glitch/receitas-api/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/cauadsts-glitch/receitas-api.git" },
  "license": "ISC",
  "author": "Mateus R. Pereira",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  }
}
